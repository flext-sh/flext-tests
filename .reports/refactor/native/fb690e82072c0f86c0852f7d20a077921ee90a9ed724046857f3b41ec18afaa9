emp(c.Tests.DOCKER_TEST_ENVIRONMENT_DIR),\n            request.config.rootpath,\n        ).unwrap()\n        with u.Tests.env_vars_context(u.Tests.external_environment_values(env_file)):\n            yield env_file\n\n\n__all__ = [\"FlextTestsCapabilityPlugin\"]\n","range":{"byteOffset":{"start":0,"end":14258},"start":{"line":0,"column":0},"end":{"line":359,"column":0}}}]},"transformed":{}},"ruleId":"ban-library-type-reference-outside-typings--flext_tests","severity":"error","note":null,"message":"`pytest` library type named inline: alias it once in the typings family and reference it as `t.<Domain>.<Name>`."}
