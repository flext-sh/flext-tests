t None:\n            lines.append(f\"flext_slow_timeout_seconds = {slow_timeout}\")\n        pytester.makeini(\"\\n\".join(lines))\n\n    @staticmethod\n    def _run_pytest(\n        pytester: t.Tests.Pytester,\n        *,\n        include_timeout_plugin: bool = True,\n        unbounded: bool = False,\n        ordinary_timeout: float | None = None,\n    ) -> t.Tests.RunResult:\n        \"\"\"Run only the two owner plugins in a subprocess-isolated session.\n\n        Returns:\n            The resulting ``pytest.RunResult``.\n\n        \"\"\"\n        variable = \"PYTEST_DISABLE_PLUGIN_AUTOLOAD\"\n        previous = os.environ.get(variable)\n        os.environ[variable] = c.ParserBooleanToken.ONE\n        enforcement = config.Infra.tooling.tools.pytest.enforcement_plugin\n        plugins = (\n            (\"-p\", \"pytest_timeout\", \"-p\", enforcement)\n            if include_timeout_plugin\n            else (\"-p\", enforcement)\n        )\n        try:\n            return u.Tests.pytest_subprocess(\n                pytester,\n                *plugins,\n                *((\"--timeout=0\",) if unbounded else ()),\n                *(\n                    (f\"--timeout={ordinary_timeout}\",)\n                    if ordinary_timeout is not None\n                    else ()\n                ),\n            )\n        finally:\n            if previous is None:\n                os.environ.pop(variable, None)\n            else:\n                os.environ[variable] = previous\n\n    @c.Tests.MARK.slow\n    def test_configured_budget_applies_only_to_explicit_slow_items(\n        self,\n        pytester: t.Tests.Pytester,\n    ) -> None:\n        \"\"\"Only slow items receive a timer; regular items have no item budget.\"\"\"\n        self._make_ini(pytester, slow_timeout=str(self.slow_timeout_seconds))\n        pytester.makepyfile(\n            \"import pytest\\n\"\n            \"\\n\"\n            \"from flext_tests import tm\\n\"\n            \"\\n\"\n            \"\\n\"\n            \"@pytest.mark.slow\\n\"\n            \"def test_slow_budget(request: pytest.FixtureRequest) -> None:\\n\"\n            \"    marker = request.node.get_closest_marker('timeout')\\n\"\n            \"    tm.ok(marker is not None)\\n\"\n            \"    if marker is not None:\\n\"\n            f\"        tm.that(marker.args, eq=({self.slow_timeout_seconds},))\\n\"\n            \"\\n\"\n            \"\\n\"\n            \"def test_regular_budget(request: pytest.FixtureRequest) -> None:\\n\"\n            \"    tm.that(request.node.get_closest_marker('timeout'), none=True)\\n\",\n        )\n\n        result = self._run_pytest(pytester)\n\n        result.assert_outcomes(passed=2)\n        result.stdout.fnmatch_lines([\n            \"*flext slow tests*\",\n            \"no test near the ordinary or slow limit\",\n        ])\n\n    @c.Tests.MARK.slow\n    def test_heavy_tier_items_share_the_slow_budget(\n        self,\n        pytester: t.Tests.Pytester,\n    ) -> None:\n        \"\"\"A heavy tier or capability receives the slow budget; a unit item does not.\"\"\"\n        self._make_ini(\n            pytester,\n            slow_timeout=str(self.slow_timeout_seconds),\n            markers=(\n                \"slow: explicitly slow contract\",\n                \"integration: heavy tier contract\",\n                \"docker: heavy capability contract\",\n                \"unit: ordinary contract\",\n            ),\n        )\n        pytester.makepyfile(\n            \"import pytest\\n\"\n            \"\\n\"\n            \"from flext_tests import tm\\n\"\n            \"\\n\"\n            \"\\n\"\n            \"@pytest.mark.integration\\n\"\n            \"def test_integration_budget(request: pytest.FixtureRequest) -> None:\\n\"\n            \"    marker = request.node.get_closest_marker('timeout')\\n\"\n            \"    tm.ok(marker is not None)\\n\"\n            \"    if marker is not None:\\n\"\n            f\"        tm.that(marker.args, eq=({self.slow_timeout_seconds},))\\n\"\n            \"\\n\"\n            \"\\n\"\n            \"@pytest.mark.docker\\n\"\n            \"def test_docker_budget(request: pytest.FixtureRequest) -> None:\\n\"\n            \"    marker = request.node.get_closest_marker('timeout')\\n\"\n            \"    tm.ok(marker is not None)\\n\"\n            \"    if marker is not None:\\n\"\n            f\"        tm.that(marker.args, eq=({self.slow_timeout_seconds},))\\n\"\n            \"\\n\"\n            \"\\n\"\n            \"@pytest.mark.unit\\n\"\n            \"def test_unit_budget(request: pytest.FixtureRequest) -> None:\\n\"\n            \"    tm.that(request.node.get_closest_marker('timeout'), none=True)\\n\",\n        )\n\n        result = self._run_pytest(pytester)\n\n        result.assert_outcomes(passed=3)\n\n    @c.Tests.MARK.slow\n    def test_unbounded_run_disables_regular_and_slow_item_timers(\n        self,\n        pytester: t.Tests.Pytester,\n    ) -> None:\n        \"\"\"The full-run override disables timers without changing owned budgets.\"\"\"\n        self._make_ini(pytester, slow_timeout=str(self.slow_timeout_seconds))\n        pytester.makepyfile(\n            \"import pytest\\n\"\n            \"from flext_tests import tm\\n\"\n            \"\\n\"\n            \"def test_unbounded(request: pytest.FixtureRequest) -> None:\\n\"\n            \"    tm.that(request.config.getoption('timeout'), eq=0)\\n\"\n            \"    tm.that(request.node.get_closest_marker('timeout'), none=True)\\n\"\n            \"\\n\"\n            \"@pytest.mark.slow\\n\"\n            \"def test_slow_unbounded(request: pytest.FixtureRequest) -> None:\\n\"\n            \"    tm.that(request.config.getoption('timeout'), eq=0)\\n\"\n            \"    tm.that(request.node.get_closest_marker('timeout'), none=True)\\n\",\n        )\n\n        self._run_pytest(pytester, unbounded=True).assert_outcomes(passed=2)\n\n    @c.Tests.MARK.slow\n    def test_absent_slow_budget_requires_no_timeout_plugin(\n        self,\n        pytester: t.Tests.Pytester,\n    ) -> None:\n        \"\"\"An unconfigured project needs no timer for slow or regular items.\"\"\"\n        self._make_ini(pytester, slow_timeout=None)\n        pytester.makepyfile(\n            \"import pytest\\n\"\n            \"\\n\"\n            \"from flext_tests import tm\\n\"\n            \"\\n\"\n            \"\\n\"\n            \"@pytest.mark.slow\\n\"\n            \"def test_slow_without_budget(request: pytest.FixtureRequest) -> None:\\n\"\n            \"    tm.that(request.node.get_closest_marker('timeout'), none=True)\\n\"\n            \"\\n\"\n            \"\\n\"\n            \"def test_regular_without_budget(request: pytest.FixtureRequest) -> None:\\n\"\n            \"    tm.that(request.node.get_closest_marker('timeout'), none=True)\\n\",\n        )\n\n        self._run_pytest(pytester, include_timeout_plugin=False).assert_outcomes(\n            passed=2\n        )\n\n    @c.Tests.MARK.slow\n    @c.Tests.MARK.parametrize(\n        \"invalid_timeout\", [c.ParserBooleanToken.ZERO, \"nan\", \"not-a-number\"]\n    )\n    @c.Tests.MARK.parametrize(\"unbounded\", [False, True])\n    def test_invalid_slow_budget_fails_closed(\n        self,\n        pytester: t.Tests.Pytester,\n        invalid_timeout: str,\n        *,\n        unbounded: bool,\n    ) -> None:\n        \"\"\"Non-positive, non-finite, and malformed policy values are rejected.\"\"\"\n        self._make_ini(pytester, slow_timeout=invalid_timeout)\n        pytester.makepyfile(\"def test_policy_probe() -> None:\\n    pass\\n\")\n\n        result = self._run_pytest(pytester, unbounded=unbounded)\n\n        tm.that(result.ret, ne=c.Tests.ExitCode.OK)\n        result.stderr.fnmatch_lines([\n            \"*FLEXT slow timeout policy:*must be a positive finite number*\",\n        ])\n\n    @c.Tests.MARK.slow\n    @c.Tests.MARK.parametrize(\"unbounded\", [False, True])\n    def test_explicit_slow_timeout_marker_fails_closed(\n        self,\n        pytester: t.Tests.Pytester,\n        *,\n        unbounded: bool,\n    ) -> None:\n        \"\"\"Slow test code cannot restate or weaken its config-owned budget.\"\"\"\n        self._make_ini(pytester, slow_timeout=str(self.slow_timeout_seconds))\n        pytester.makepyfile(\n            \"import pytest\\n\"\n            \"\\n\"\n            \"\\n\"\n            \"@pytest.mark.slow\\n\"\n            f\"@pytest.mark.timeout({self.slow_timeout_seconds})\\n\"\n            \"def test_explicit_timeout() -> None:\\n\"\n            \"    pass\\n\",\n        )\n\n        result = self._run_pytest(pytester, unbounded=unbounded)\n\n        tm.that(result.ret, ne=c.Tests.ExitCode.OK)\n        result.stderr.fnmatch_lines([\n            \"*FLEXT slow timeout policy:*explicit pytest.mark.timeout is forbidden*\",\n        ])\n\n    @c.Tests.MARK.slow\n    def test_configured_policy_requires_pytest_timeout(\n        self,\n        pytester: t.Tests.Pytester,\n    ) -> None:\n        \"\"\"Configured slow budgets fail if the timer owner is not loaded.\"\"\"\n        self._make_ini(pytester, slow_timeout=str(self.slow_timeout_seconds))\n        pytester.makepyfile(\"def test_policy_probe() -> None:\\n    pass\\n\")\n\n        result = self._run_pytest(pytester, include_timeout_plugin=False)\n\n        tm.that(result.ret, ne=c.Tests.ExitCode.OK)\n        result.stderr.fnmatch_lines([\n            \"*FLEXT slow timeout policy requires the pytest-timeout plugin*\",\n        ])\n\n    @c.Tests.MARK.slow\n    def test_report_lists_passed_items_near_their_limit_by_share(\n        self,\n        pytester: t.Tests.Pytester,\n    ) -> None:\n        \"\"\"Near-limit regular and slow items are listed; fast and far ones are not.\"\"\"\n        self._make_ini(pytester, slow_timeout=str(self.report_slow_timeout_seconds))\n        pytester.makepyfile(\n            \"import time\\n\"\n            \"\\n\"\n            \"import pytest\\n\"\n            \"\\n\"\n            \"\\n\"\n            \"def test_regular_near_limit() -> None:\\n\"\n            \"    time.sleep(1.7)\\n\"\n            \"\\n\"\n            \"\\n\"\n            \"@pytest.mark.slow\\n\"\n            \"def test_slow_near_limit() -> None:\\n\"\n            \"    time.sleep(2.5)\\n\"\n            \"\\n\"\n            \"\\n\"\n            \"@pytest.mark.slow\\n\"\n            \"def test_slow_far_from_limit() -> None:\\n\"\n            \"    time.sleep(0.1)\\n\"\n            \"\\n\"\n            \"\\n\"\n            \"def test_fast() -> None:\\n\"\n            \"    pass\\n\",\n        )\n\n        result = self._run_pytest(\n            pytester, ordinary_timeout=self.report_ordinary_timeout_seconds\n        )\n\n        result.assert_outcomes(passed=4)\n        result.stdout.fnmatch_lines([\n            \"*flext slow tests*\",\n            \"1 near the ordinary limit; 1 near the slow limit\",\n        ])\n        result.stdout.fnmatch_lines_random([\n            \"*% of the 3.00s slow limit (*s): *::test_slow_near_limit\",\n            \"*% of the 2.00s ordinary limit (*s): *::test_regular_near_limit\",\n        ])\n        result.stdout.no_fnmatch_line(\"*limit (*::test_fast\")\n        result.stdout.no_fnmatch_line(\"*limit (*::test_slow_far_from_limit\")\n","range":{"byteOffset":{"start":0,"end":11473},"start":{"line":0,"column":0},"end":{"line":317,"column":0}}},{"text":"os","range":{"byteOffset":{"start":1506,"end":1508},"start":{"line":51,"column":19},"end":{"line":51,"column":21}}},{"text":"environ","range":{"byteOffset":{"start":1509,"end":1516},"start":{"line":51,"column":22},"end":{"line":51,"column":29}}}]},"transformed":{}},"ruleId":"ban-ambient-environ-read--flext_tests","severity":"error","note":null,"message":"Ambient os.environ/os.getenv read outside the typed settings boundary: read the value through config.<Ns>.* or settings.<Ns>.* (owned by settings.py / _settings/) instead of the raw process environment."}
