ector,\n                cfg,\n                context,\n            ),\n        ]\n\n\n__all__: list[str] = [\"FlextTestsEnforcementBuilder\"]\n","range":{"byteOffset":{"start":0,"end":2651},"start":{"line":0,"column":0},"end":{"line":81,"column":0}}}]},"transformed":{}},"ruleId":"ban-library-type-reference-outside-typings--flext_tests","severity":"error","note":null,"message":"`pytest` library type named inline: alias it once in the typings family and reference it as `t.<Domain>.<Name>`."}
