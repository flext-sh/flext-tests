from collections.abc import Generator\nfrom pathlib import Path\n\nimport pytest\n\nfrom flext_tests import FlextTestsDocker, c, m, t, u\n\n\nclass FlextTestsCapabilityPlugin:\n    \"\"\"Shared marker-driven applicability owner for every consumer conftest.\"\"\"\n\n    def __init__(self) -> None:\n        \"\"\"Own prerequisite accounting for this pytest session.\"\"\"\n        self._prerequisite_skip_key = pytest.StashKey[\n            tuple[BaseException, pytest.Mark, str]\n        ]()\n        self._prerequisite_report_key = pytest.StashKey[bool]()\n\n    @staticmethod\n    def pytest_addoption(parser: pytest.Parser) -> None:\n        \"\"\"Declare the Make CI token keys the generated pytest config projects.\"\"\"\n        parser.addini(\n            c.Tests.DOCKER_CI_VARIABLE_INI,\n            default=\"\",\n            help=\"Make CI token variable (projected from flext-infra).\",\n        )\n        parser.addini(\n            c.Tests.DOCKER_CI_VALUE_INI,\n            default=\"\",\n            help=\"Make CI token value (projected from flext-infra).\",\n        )\n\n    @staticmethod\n    def pytest_configure(config: pytest.Config) -> None:\n        config.addinivalue_line(\n            \"markers\",\n            \"connectivity(required_vars=(), url_var=None, host=None, port=None, \"\n            \"executables=()): external test environment and host executables\",\n        )\n\n    @staticmethod\n    def _declaration(\n        marker: pytest.Mark,\n    ) -> tuple[tuple[str, ...], str | None, tuple[str, ...]]:\n        if marker.args or marker.kwargs.keys() - {\n            \"required_vars\",\n            \"url_var\",\n            \"host\",\n            \"port\",\n            \"executables\",\n        }:\n            msg = \"Connectivity declarations require supported keyword arguments\"\n            raise pytest.UsageError(msg)\n        required = marker.kwargs.get(\"required_vars\", ())\n        url_var = marker.kwargs.get(\"url_var\")\n        try:\n            names = u.type_adapter(\n                tuple[t.NonEmptyStr, ...] | list[t.NonEmptyStr]\n            ).validate_python(required, strict=True)\n        except m.ValidationError as exc:\n            msg = \"Connectivity required_vars must be names\"\n            raise pytest.UsageError(msg) from exc\n        if any(not name.strip() for name in names):\n            msg = \"Connectivity required_vars must be names\"\n            raise pytest.UsageError(msg)\n        if url_var is not None and (\n            not isinstance(url_var, str) or not url_var.strip()\n        ):\n            msg = \"Connectivity url_var must be a name\"\n            raise pytest.UsageError(msg)\n        host = marker.kwargs.get(\"host\")\n        port = marker.kwargs.get(\"port\")\n        if host is not None or port is not None:\n            try:\n                u.type_adapter(tuple[t.NonEmptyStr, t.PortNumber]).validate_python(\n                    (host, port), strict=True\n                )\n            except m.ValidationError as exc:\n                msg = \"Connectivity host and port must be a string and an integer\"\n                raise pytest.UsageError(msg) from exc\n            if isinstance(host, str) and not host.strip():\n                msg = \"Connectivity host and port must be a string and an integer\"\n                raise pytest.UsageError(msg)\n        return tuple(names), url_var, FlextTestsCapabilityPlugin._executables(marker)\n\n    def _reason(\n        self,\n        root: Path,\n        marker: pytest.Mark,\n        declaration: tuple[tuple[str, ...], str | None, tuple[str, ...]],\n    ) -> str | None:\n        \"\"\"Resolve the unmet prerequisite for one connectivity marker.\n\n        Returns:\n            The skip reason, or ``None`` when the environment is ready.\n\n        \"\"\"\n        required, url_var, executables = declaration\n        missing = tuple(name for name in executables if shutil.which(name) is None)\n        if missing:\n            return f\"Host executable is unavailable: {', '.join(missing)}\"\n        if executables and marker.kwargs.keys() == {\"executables\"}:\n            return None\n        return self._resolve_marker_reason(root, marker, required, url_var)\n\n    @staticmethod\n    def _executables(marker: pytest.Mark) -> tuple[str, ...]:\n        \"\"\"Validate the host executables one marker declares.\n\n        Returns:\n            The declared executable names, empty when none is declared.\n\n        Raises:\n            pytest.UsageError: If ``executables`` is not a sequence of names.\n\n        \"\"\"\n        try:\n            names = u.type_adapter(\n                tuple[t.NonEmptyStr, ...] | list[t.NonEmptyStr]\n            ).validate_python(marker.kwargs.get(\"executables\", ()), strict=True)\n        except m.ValidationError as exc:\n            msg = \"Connectivity executables must be names\"\n            raise pytest.UsageError(msg) from exc\n        if any(not name.strip() for name in names):\n            msg = \"Connectivity executables must be names\"\n            raise pytest.UsageError(msg)\n        return tuple(names)\n\n    @staticmethod\n    def _requires_docker(marker: pytest.Mark) -> bool:\n        return marker.name == \"docker\" or (\n            marker.name in c.Tests.CONNECTIVITY_MARKER_CONTAINERS\n            and marker.kwargs.get(\"url_var\") is None\n            and not (\n                isinstance(marker.kwargs.get(\"host\"), str)\n                and isinstance(marker.kwargs.get(\"port\"), int)\n            )\n        )\n\n    @staticmethod\n    def _resolve_marker_reason(\n        root: Path,\n        marker: pytest.Mark,\n        required: tuple[str, ...],\n        url_var: str | None,\n    ) -> str | None:\n        if FlextTestsCapabilityPlugin._requires_docker(marker):\n            # Docker-provisioned: the suite builds its own isolated environment\n            # (docker_test_environment); only the daemon and container matter.\n            reason = FlextTestsCapabilityPlugin._docker_reason(root)\n            if reason is not None or marker.name == c.Tests.DOCKER_CONNECTIVITY_MARKER:\n                return reason\n            return FlextTestsCapabilityPlugin._provisioned_reason(marker)\n        return FlextTestsCapabilityPlugin._container_reason(marker, required, url_var)\n\n    @staticmethod\n    def _docker_reason(root: Path) -> str | None:\n        \"\"\"Require the untracked ``.env`` to name the daemon, then probe it.\n\n        Returns:\n            The unmet prerequisite, or ``None`` when the named daemon answers.\n\n        \"\"\"\n        client = FlextTestsDocker(repository_root=root).client\n        if client.failure:\n            if client.error == c.Tests.DOCKER_NOT_CONFIGURED_REASON:\n                return c.Tests.DOCKER_NOT_CONFIGURED_REASON\n            return f\"Docker test environment is unreachable: {client.error}\"\n        client.value.close()\n        return None\n\n    @staticmethod\n    def _provisioned_reason(marker: pytest.Mark) -> str | None:\n        \"\"\"Resolve a shared container's published endpoint and probe it.\n\n        Returns:\n            The unmet prerequisite, or ``None`` when the service accepts.\n\n        Raises:\n            ValueError: If the connectivity container declares no port.\n\n        \"\"\"\n        container = c.Tests.CONNECTIVITY_MARKER_CONTAINERS[marker.name]\n        declared = FlextTestsDocker.shared_target_config(container)\n        if declared.port is None:\n            msg = f\"Connectivity container declares no port: {container}\"\n            raise ValueError(msg)\n        # A selected capability invokes its provisioning owner explicitly.\n        # That owner creates an absent service and preserves existing data.\n        info = FlextTestsDocker.shared(container).execute().unwrap()\n        port = u.Tests.resolve_host_port(info, declared.port)\n        if port.failure:\n            return \"External test service port is unavailable\"\n        return u.Tests.endpoint_reason((declared.host, port.value))\n\n    @staticmethod\n    def _container_reason(\n        marker: pytest.Mark,\n        required: tuple[str, ...],\n        url_var: str | None,\n    ) -> str | None:\n        endpoint: tuple[str, int] | None = None\n        host = marker.kwargs.get(\"host\")\n        port_number = marker.kwargs.get(\"port\")\n        if isinstance(host, str) and isinstance(port_number, int):\n            endpoint = (host, port_number)\n        if endpoint is None and url_var is None:\n            return \"External test endpoint is not declared\"\n        return u.Tests.external_environment_reason(\n            required,\n            endpoint=endpoint,\n            url_var=url_var,\n        )\n\n    @pytest.hookimpl(wrapper=True)\n    def pytest_runtest_protocol(\n        self,\n        item: pytest.Item,\n    ) -> Generator[None, None, bool | None]:\n        \"\"\"Keep prerequisite accounting scoped to the selected test.\n\n        Returns:\n            The wrapped protocol outcome, or ``None`` when no markers apply.\n\n        \"\"\"\n        try:\n            return (yield)\n        finally:\n            if self._prerequisite_skip_key in item.stash:\n                del item.stash[self._prerequisite_skip_key]\n            if self._prerequisite_report_key in item.stash:\n                del item.stash[self._prerequisite_report_key]\n\n    def _skip_prerequisite(\n        self, item: pytest.Item, marker: pytest.Mark, reason: str\n    ) -> None:\n        \"\"\"Retain the exact owner exception, never a caller-supplied property.\n\n        Raises:\n            Exception: If a ``pytest.skip.Exception`` is caught.\n\n        \"\"\"\n        try:\n            pytest.skip(reason)\n        except pytest.skip.Exception as exc:\n            item.stash[self._prerequisite_skip_key] = (exc, marker, reason)\n            raise\n\n    @pytest.hookimpl(wrapper=True, tryfirst=True)\n    def pytest_runtest_makereport(\n        self, item: pytest.Item, call: pytest.CallInfo[None]\n    ) -> Generator[None, pytest.TestReport, pytest.TestReport]:\n        \"\"\"Seal owner setup evidence after other report hooks, including teardown.\n\n        JUnit finalizes properties from teardown; preserve the validated setup\n        receipt there while removing reserved properties supplied by consumers.\n\n        Returns:\n            The sanitized report.\n\n        \"\"\"\n        report = yield\n        report.user_properties = [\n            prop\n            for prop in report.user_properties\n            if not prop[0].startswith(\"flext_connectivity_prerequisite\")\n        ]\n        receipt = item.stash.get(self._prerequisite_skip_key, None)\n        if call.when == \"setup\":\n            item.stash[self._prerequisite_report_key] = (\n                receipt is not None\n                and call.excinfo is not None\n                and call.excinfo.value is receipt[0]\n                and report.skipped\n                and report.when == \"setup\"\n                and report.nodeid == item.nodeid\n                and isinstance(report.longrepr, tuple)\n                and report.longrepr[2] == f\"Skipped: {receipt[2]}\"\n                and any(marker is receipt[1] for marker in item.iter_markers())\n            )\n        elif call.when == \"call\" or report.skipped or report.failed:\n            item.stash[self._prerequisite_report_key] = False\n        if receipt is not None and item.stash.get(self._prerequisite_report_key, False):\n            report.user_properties.extend([\n                (\"flext_connectivity_prerequisite\", receipt[2]),\n                (\"flext_connectivity_prerequisite_phase\", \"setup\"),\n                (\"flext_connectivity_prerequisite_capability\", receipt[1].name),\n                (\"flext_connectivity_prerequisite_node\", item.nodeid),\n            ])\n        return report\n\n    @pytest.hookimpl(tryfirst=True)\n    def pytest_runtest_setup(self, item: pytest.Item) -> None:\n        \"\"\"Skip before fixtures, after all consumer collection hooks added markers.\n\n        Only connectivity markers select this policy. The flext-infra runner\n        owns generic external-gate applicability, including ``remote``;\n        selected services still require their declared inputs and transport.\n        \"\"\"\n        markers = [\n            marker\n            for marker in item.iter_markers()\n            if marker.name in {*c.Tests.CONNECTIVITY_MARKERS, \"connectivity\"}\n        ]\n        declarations = [(marker, self._declaration(marker)) for marker in markers]\n        for marker, declaration in declarations:\n            reason = self._reason(item.config.rootpath, marker, declaration)\n            if reason is not None:\n                self._skip_prerequisite(item, marker, reason)\n\n    @pytest.hookimpl(trylast=True)\n    def pytest_collection_modifyitems(self, items: list[pytest.Item]) -> None:\n        \"\"\"Request the isolated environment fixture for Docker-provisioned items.\n\n        Runs last, so markers added by consumer collection hooks count.\n        \"\"\"\n        for item in items:\n            if isinstance(item, pytest.Function) and any(\n                marker.name in c.Tests.CONNECTIVITY_MARKERS\n                and self._requires_docker(marker)\n                for marker in item.iter_markers()\n            ):\n                item.fixturenames.append(c.Tests.DOCKER_TEST_ENVIRONMENT_FIXTURE)\n\n    @pytest.fixture\n    @staticmethod\n    def docker_test_environment(\n        request: pytest.FixtureRequest,\n    ) -> Generator[Path]:\n        \"\"\"Give a Docker-provisioned test its own generated, isolated ``.env``.\n\n        Yields:\n            The generated environment file, applied for the test's duration.\n\n        \"\"\"\n        factory: pytest.TempPathFactory = request.getfixturevalue(\"tmp_path_factory\")\n        env_file = u.Tests.docker_environment_file(\n            factory.mktemp(c.Tests.DOCKER