{"text":"os.environ.get(\"PYTHONPATH\")","range":{"byteOffset":{"start":2526,"end":2554},"start":{"line":79,"column":58},"end":{"line":79,"column":86}},"file":"src/flext_tests/_utilities/testcontext.py","lines":"                        filter(None, (str(pytester.path), os.environ.get(\"PYTHONPATH\")))","charCount":{"leading":58,"trailing":2},"language":"Python","metaVariables":{"single":{"ENV":{"text":"os.environ","range":{"byteOffset":{"start":2526,"end":2536},"start":{"line":79,"column":58},"end":{"line":79,"column":68}}},"OSMODULE":{"text":"os","range":{"byteOffset":{"start":212,"end":214},"start":{"line":9,"column":7},"end":{"line":9,"column":9}}}},"multi":{"secondary":[{"text":"os","range":{"byteOffset":{"start":212,"end":214},"start":{"line":9,"column":7},"end":{"line":9,"column":9}}},{"text":"import os","range":{"byteOffset":{"start":205,"end":214},"start":{"line":9,"column":0},"end":{"line":9,"column":9}}},{"text":"\"\"\"Test execution contexts shared by every test process of one machine.\n\nCopyright (c) 2026 FLEXT Team. All rights reserved.\nSPDX-License-Identifier: MIT\n\"\"\"\n\nfrom __future__ import annotations\n\nimport io\nimport os\nimport shutil\nimport signal\nimport sys\nimport tempfile\nimport time\nimport types\nfrom collections.abc import Callable, Generator, Mapping, Sequence\nfrom contextlib import contextmanager, redirect_stderr, redirect_stdout\nfrom pathlib import Path\nfrom threading import current_thread, get_ident, main_thread\nfrom typing import BinaryIO\n\nimport pytest\nfrom flext_cli import u as flext_cli_u\n\nfrom flext_tests import c, m, p\nfrom flext_tests._utilities import FlextTestsUtilitiesConfigHelpers\n\nif sys.platform == \"win32\":\n    import msvcrt\nelse:\n    import fcntl\n\n\nclass FlextTestsUtilitiesTestContext:\n    \"\"\"Context managers for tests.\"\"\"\n\n    @staticmethod\n    def pytest_subprocess(\n        pytester: pytest.Pytester,\n        *args: str | Path,\n    ) -> pytest.RunResult:\n        \"\"\"Run an isolated pytest consumer through the canonical process owner.\n\n        Preserve pytester's sandbox, interpreter, explicit plugins, inherited\n        options and independent numbered temporary directory. CLI owns signal\n        forwarding, descendant cleanup and reaping even when the calling item\n        is interrupted; stdout and stderr remain in the sandbox on failure.\n\n        Returns:\n            The native pytest result over the child's exact output and status.\n\n        Raises:\n            TypeError: If a subprocess plugin is not an importable name.\n\n        \"\"\"\n        plugins: list[str] = []\n        for plugin in pytester.plugins:\n            if not isinstance(plugin, str):\n                msg = \"Subprocess pytest plugins must be importable names\"\n                raise TypeError(msg)\n            plugins.extend((\"-p\", plugin))\n        basetemp = tempfile.mkdtemp(prefix=\"runpytest-\", dir=pytester.path)\n        stdout = pytester.path / \"stdout\"\n        stderr = pytester.path / \"stderr\"\n        started = time.monotonic()\n        outcome = flext_cli_u.Cli.run_to_file(\n            (\n                sys.executable,\n                \"-mpytest\",\n                *plugins,\n                f\"--basetemp={basetemp}\",\n                *(str(argument) for argument in args),\n            ),\n            stdout,\n            cwd=pytester.path,\n            options=m.Cli.ProcessOptions(\n                env={\n                    \"PYTHONPATH\": os.pathsep.join(\n                        filter(None, (str(pytester.path), os.environ.get(\"PYTHONPATH\")))\n                    ),\n                },\n                stderr_file=stderr,\n            ),\n        ).unwrap()\n        return pytest.RunResult(\n            outcome.raw_return_code,\n            stdout.read_text(encoding=\"utf-8\").splitlines(),\n            stderr.read_text(encoding=\"utf-8\").splitlines(),\n            time.monotonic() - started,\n        )\n\n    @staticmethod\n    def cli_in_process(\n        entrypoint: Callable[[Sequence[str]], int],\n        argv: Sequence[str],\n        *,\n        env: Mapping[str, str] | None = None,\n    ) -> p.Cli.CommandOutput:\n        \"\"\"Run a CLI entry point in-process and capture its process-equivalent result.\n\n        The call owns the environment scope, the standard streams and the\n        termination handlers the CLI installs, restoring each afterwards. The\n        captured output renders unstyled (``TERM=dumb``, which a caller ``env``\n        entry still overrides), so text assertions hold in styled CI. An\n        entry point that raises :class:`SystemExit` returns its declared code;\n        any other failure propagates unchanged.\n\n        Args:\n            entrypoint: The CLI entry point receiving the argument vector.\n            argv: The arguments, without the interpreter or program name.\n            env: Environment variables owned only for this call.\n\n        Returns:\n            The captured output and the normalized exit code.\n\n        \"\"\"\n        stdout, stderr = io.StringIO(), io.StringIO()\n        on_main_thread = current_thread() is main_thread()\n        previous_handlers = (\n            {\n                number: signal.getsignal(number)\n                for number in (signal.SIGTERM, signal.SIGINT)\n            }\n            if on_main_thread\n            else {}\n        )\n        started = time.monotonic()\n        code = 0\n        try:\n            with (\n                FlextTestsUtilitiesConfigHelpers.env_vars_context({\n                    \"TERM\": \"dumb\",\n                    **(env or {}),\n                }),\n                redirect_stdout(stdout),\n                redirect_stderr(stderr),\n            ):\n                try:\n                    code = entrypoint(list(argv))\n                except SystemExit as stopped:\n                    code = FlextTestsUtilitiesTestContext._exit_code(stopped)\n        finally:\n            for number, handler in previous_handlers.items():\n                signal.signal(number, handler)\n        return m.Cli.CommandOutput(\n            outcome=m.Cli.ProcessOutcome(\n                raw_return_code=code,\n                timed_out=False,\n                forwarded_signal=None,\n            ),\n            duration=time.monotonic() - started,\n            stdout=stdout.getvalue(),\n            stderr=stderr.getvalue(),\n        )\n\n    @staticmethod\n    def _exit_code(stopped: SystemExit) -> int:\n        \"\"\"Normalize the native ``SystemExit`` payload to a process code.\n\n        Returns:\n            The declared integer code, ``0`` for ``None`` and ``1`` otherwise.\n\n        \"\"\"\n        if stopped.code is None:\n            return 0\n        return stopped.code if isinstance(stopped.code, int) else 1\n\n    class SessionRuntime:\n        \"\"\"Single-flight, lazy consumer runtime in one random worker-session area.\n\n        The installed pytest fixture owns allocation and cleanup. A single\n        provision callback performs canonical locked Make setup/upgrade once.\n        Each exclusive lease restores the seed's source, Git and case data at\n        the same absolute path, preserving real editable imports. Scenarios\n        that mutate installed packages also restore the physical environment,\n        without resolving or reinstalling dependencies between cases.\n        \"\"\"\n\n        def __init__(self, directory: Path, *, storage: Path) -> None:\n            self.directory = directory.resolve(strict=True)\n            self.storage = storage\n            self._allocation = self.directory.stat()\n            self._root: Path | None = None\n            self._provision: p.Tests.RuntimeProvision | None = None\n            self._failure: BaseException | None = None\n            self._active_thread: int | None = None\n            self._source = self.directory / \"source\"\n            self._environment = self.directory / \"environment\"\n\n        def _assert_owned(self, path: Path) -> None:\n            \"\"\"Reject redirected paths using the original physical allocation identity.\n\n            Args:\n                path: The path to check against the original physical allocation.\n\n            Raises:\n                ValueError: If the path has escaped its original physical allocation.\n\n            \"\"\"\n            allocation = self._source.parent\n            state = allocation.stat(follow_symlinks=False)\n            candidate = path.absolute()\n            if (\n                self.directory != allocation\n                or allocation.resolve() != allocation\n                or (state.st_dev, state.st_ino)\n                != (self._allocation.st_dev, self._allocation.st_ino)\n                or not candidate.resolve().is_relative_to(allocation)\n                or any(\n                    ancestor.is_symlink()\n                    for ancestor in (candidate, *candidate.parents)\n                    if ancestor.is_relative_to(allocation)\n                )\n            ):\n                msg = \"Session runtime path escaped its original physical allocation\"\n                raise ValueError(msg)\n\n        def close(self) -> None:\n            \"\"\"Remove only the unchanged physical session allocation.\"\"\"\n            self._assert_owned(self.directory)\n            shutil.rmtree(self.directory)\n\n        def _provision_session_root(\n            self,\n            provision: p.Tests.RuntimeProvision,\n        ) -> Path:\n            \"\"\"Create and authenticate the session checkout exactly once.\n\n            Returns:\n                The provisioned session root.\n\n            Raises:\n                ValueError: If the checkout leaves its own area.\n\n            \"\"\"\n            root = self._root\n            if root is not None:\n                return root\n            self._provision = provision\n            parent = self.directory / \"project\"\n            parent.mkdir()\n            root = provision(parent)\n            self._assert_owned(parent)\n            self._assert_owned(root)\n            if not root.resolve().is_relative_to(parent):\n                msg = \"Session runtime checkout must belong to its own area\"\n                raise ValueError(msg)\n            root = root.resolve()\n            self._root = root\n            return root\n\n        def _lease_targets(\n            self,\n            *,\n            mutable_environment: bool,\n        ) -> list[tuple[Path, Path]]:\n            \"\"\"Return the runtime directories with their baseline mirrors.\n\n            Returns:\n                The owned runtime directories and their seed baselines.\n\n            Raises:\n                ValueError: If the runtime root or environment is invalid.\n\n            \"\"\"\n            root = self._root\n            if root is None:\n                msg = \"Session runtime requires its provisioned root\"\n                raise ValueError(msg)\n            environment = root / c.VENV_DIR_NAME\n            self._assert_owned(environment)\n            if not (environment / \"pyvenv.cfg\").is_file():\n                msg = \"Session runtime requires its own physical environment\"\n                raise ValueError(msg)\n            targets = [(root, self._source)]\n            if mutable_environment:\n                targets.append((environment, self._environment))\n            return targets\n\n        def _seed_lease_baselines(\n            self,\n            targets: Sequence[tuple[Path, Path]],\n        ) -> None:\n            \"\"\"Mirror each absent runtime baseline from its live directory.\"\"\"\n            for target, baseline in targets:\n                if baseline.exists():\n                    continue\n                ignore = (\n                    shutil.ignore_patterns(c.VENV_DIR_NAME)\n                    if target == self._root\n                    else None\n                )\n                shu