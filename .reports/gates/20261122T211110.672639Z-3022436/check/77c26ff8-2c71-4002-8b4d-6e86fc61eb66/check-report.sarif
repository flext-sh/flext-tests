        {
          "ruleId": "ban-loose-module-object",
          "level": "error",
          "message": {
            "text": "Loose object at module level: nest `FlextTestsConfig` inside the module's single facade class. Only that class, its canonical published bindings, __all__ and imports live at module level in every Python file of the repository; the sole exceptions are a guarded executable `main()`, generator-emitted dunders and, in conftest.py and tests/fixtures/** only, pytest fixtures and hooks."
          },
          "locations": [
            {
              "physicalLocation": {
